# Variables d'environnement pour le dashboard freelance
# Copier ce fichier en .env.local et renseigner les valeurs réelles.
# Ne JAMAIS committer .env ou .env.local dans Git.

# URL publique du projet Supabase (visible dans Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Clé anon/publishable du projet Supabase (visible dans Project Settings > API)
# Cette clé est destinée au navigateur — elle n'est PAS un secret.
# Ne jamais utiliser ici la clé service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
